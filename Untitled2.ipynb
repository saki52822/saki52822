# 放在你的 GitHub repo:  .github/workflows/daily-jobs.yml
name: daily-104-jobs

on:
  schedule:
    - cron: "0 1 * * *"   # UTC 01:00 = 台灣時間每天 09:00
  workflow_dispatch:       # 也可以手動按「Run workflow」測試

permissions:
  contents: write          # 需要把 seen_jobs.json 存回 repo，避免重複寄

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install requests
      - name: Run digest
        env:
          GMAIL_USER: ${{ secrets.GMAIL_USER }}
          GMAIL_APP_PASSWORD: ${{ secrets.GMAIL_APP_PASSWORD }}
          MAIL_TO: ${{ secrets.MAIL_TO }}
        run: python job_digest.py
      - name: Save seen jobs
        run: |
          git config user.name "job-bot"
          git config user.email "job-bot@users.noreply.github.com"
          git add seen_jobs.json || true
          git commit -m "update seen jobs" || echo "no changes"
          git push || true


#!/usr/bin/env python3
"""
104 大型科技業職缺推薦 → 寄到你的 Gmail
用法:
  python job_digest.py --dry-run     # 只在終端機顯示，不寄信（先用這個測試）
  python job_digest.py               # 寄信

需要的環境變數（寄信時）:
  GMAIL_USER          你的 Gmail 帳號，例如 ruby52824@gmail.com
  GMAIL_APP_PASSWORD  Gmail「應用程式密碼」(16 碼，不是登入密碼)
  MAIL_TO             收件信箱（可省略，預設寄給自己）

只需要 requests:  pip install requests
"""
import argparse
import json
import os
import re
import smtplib
import ssl
import time
from datetime import datetime
from email.mime.text import MIMEText
from pathlib import Path

import requests

# ====================== 你可以自己改的設定 ======================

KEYWORDS = [
    "助理專案經理", "軟體專案管理師", "專案管理師", "專案助理", "PMO",
    "Junior PM", "Software PM", "Project Manager",
    "商業數據分析", "營運數據分析", "數據分析師", "Business Data Analyst", "Data Analyst",
    "助理產品經理", "產品經理", "Associate Product Manager", "Product Manager",
]

# 台北市 / 新北市 (104 地區碼)
AREAS = "6001001000,6001002000"

# 優先區域：地址含這些字會標「⭐科學園區」
PRIORITY_DISTRICTS = ["南港", "內湖", "汐止"]

# 只保留這些區（空清單 = 不限，台北/新北全部）
ONLY_DISTRICTS = []  # 例如 ["南港", "內湖", "汐止"]

# 月薪下限（面議的職缺會保留並標示「面議」，請自行確認）
MIN_SALARY = 50000

# 大型科技公司白名單（公司名稱「包含」下列任一字串就算）
# 104 搜尋結果沒有「公司規模」欄位，所以用白名單判斷「大型、知名」。
# 想追加公司就直接加在這裡。
BIG_TECH = [
    # 半導體 / IC
    "台灣積體電路", "聯發科", "聯詠", "瑞昱", "聯電", "日月光", "群聯", "創意電子",
    "世界先進", "力積電", "矽品", "穩懋", "義隆", "原相", "譜瑞", "祥碩", "旺宏",
    # 硬體 / 品牌 / 電子
    "華碩", "宏碁", "微星", "技嘉", "廣達", "緯創", "緯穎", "仁寶", "英業達",
    "和碩", "鴻海", "富士康", "研華", "台達電", "光寶", "友達", "群創", "神達", "神基",
    # 軟體 / 網路 / 雲端 / 資安
    "趨勢科技", "精誠資訊", "叡揚", "關貿網路", "凌網", "數位無限", "Gogolook", "KKBOX",
    "LINE", "蝦皮", "Shopee", "新加坡商", "酷澎", "Coupang", "foodpanda", "Uber",
    "momo", "富邦媒體", "PChome", "網家", "91APP", "資策會", "鼎新", "凌群", "中華電信",
    "遠傳", "台灣大哥大", "台灣之星",
    # 外商科技
    "Google", "谷歌", "Microsoft", "微軟", "Amazon", "亞馬遜", "AWS", "Apple", "蘋果",
    "Meta", "Intel", "英特爾", "NVIDIA", "輝達", "Qualcomm", "高通", "AMD", "Cisco",
    "思科", "IBM", "Oracle", "甲骨文", "SAP", "Synopsys", "新思", "Cadence", "益華",
    "Micron", "美光", "Dell", "戴爾", "HP", "惠普", "Salesforce", "Adobe", "Garmin", "佳明",
    "Texas Instruments", "德州儀器", "Marvell", "邁威爾", "Broadcom", "博通",
    "Booking", "Agoda", "Trend Micro", "VMware", "ServiceNow", "Splunk", "Yahoo", "雅虎",
]

# 標題含這些字 → 通常要求資深，直接排除（你是 1~2 年資歷）
EXCLUDE_TITLE = r"資深|Senior|Sr\.|主任|協理|副理|總監|Director|VP|Head|Principal|Staff|Lead|主管|課長"

# 每個關鍵字抓幾頁（每頁約 20 筆）
PAGES_PER_KEYWORD = 2

# ================================================================

SEEN_FILE = Path(__file__).with_name("seen_jobs.json")
API = "https://www.104.com.tw/jobs/search/api/jobs"
HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                  "(KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "Referer": "https://www.104.com.tw/jobs/search/",
    "Accept": "application/json, text/plain, */*",
}


def fetch(keyword, page):
    params = {
        "keyword": keyword,
        "area": AREAS,
        "order": 15,       # 依日期排序；若結果怪怪的可改成 1（符合度）
        "asc": 0,
        "page": page,
        "mode": "s",
        "jobsource": "index_s",
        "langFlag": 0,
    }
    r = requests.get(API, params=params, headers=HEADERS, timeout=20)
    r.raise_for_status()
    return r.json().get("data", {}).get("list", [])


def is_big_tech(company):
    c = company.lower()
    return any(name.lower() in c for name in BIG_TECH)


def parse_job(j):
    link = (j.get("link") or {}).get("job", "")
    if link.startswith("//"):
        link = "https:" + link
    low = int(j.get("salaryLow") or 0)
    high = int(j.get("salaryHigh") or 0)
    return {
        "id": link.rstrip("/").split("/")[-1].split("?")[0] or j.get("jobNo", ""),
        "title": j.get("jobName", ""),
        "company": j.get("custName", ""),
        "addr": (j.get("jobAddrNoDesc", "") + j.get("jobAddress", "")),
        "salary_low": low,
        "salary_high": high,
        "salary_desc": j.get("salaryDesc", ""),
        "date": j.get("appearDate", ""),
        "link": link,
    }


def passes(job):
    if not job["id"] or not is_big_tech(job["company"]):
        return False
    if re.search(EXCLUDE_TITLE, job["title"], re.I):
        return False
    if ONLY_DISTRICTS and not any(d in job["addr"] for d in ONLY_DISTRICTS):
        return False
    # 薪資：有明確數字時，上限要 >= MIN_SALARY；面議(0) 則保留
    if job["salary_high"] and job["salary_high"] < MIN_SALARY:
        return False
    return True


def collect():
    found = {}
    for kw in KEYWORDS:
        for page in range(1, PAGES_PER_KEYWORD + 1):
            try:
                jobs = fetch(kw, page)
            except Exception as e:  # noqa
                print(f"[警告] 搜尋「{kw}」第 {page} 頁失敗: {e}")
                break
            if not jobs:
                break
            for j in jobs:
                job = parse_job(j)
                if job["id"] and job["id"] not in found and passes(job):
                    found[job["id"]] = job
            time.sleep(1.2)  # 禮貌性延遲，避免被擋
    return list(found.values())


def load_seen():
    if SEEN_FILE.exists():
        return set(json.loads(SEEN_FILE.read_text(encoding="utf-8")))
    return set()


def save_seen(seen):
    SEEN_FILE.write_text(json.dumps(sorted(seen), ensure_ascii=False), encoding="utf-8")


def sort_key(job):
    priority = any(d in job["addr"] for d in PRIORITY_DISTRICTS)
    return (not priority, job["company"])


def build_html(jobs):
    rows = []
    for j in sorted(jobs, key=sort_key):
        star = "⭐科學園區 " if any(d in j["addr"] for d in PRIORITY_DISTRICTS) else ""
        sal = j["salary_desc"] or ("面議" if not j["salary_high"] else
                                   f"{j['salary_low']:,}~{j['salary_high']:,}")
        rows.append(
            f"<tr><td>{star}<b>{j['company']}</b></td>"
            f"<td><a href='{j['link']}'>{j['title']}</a></td>"
            f"<td>{j['addr'][:14]}</td><td>{sal}</td><td>{j['date']}</td></tr>"
        )
    return (
        f"<h3>今日 104 新職缺（{datetime.now():%Y-%m-%d}）共 {len(jobs)} 筆</h3>"
        "<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse'>"
        "<tr><th>公司</th><th>職稱</th><th>地點</th><th>薪資</th><th>刊登日</th></tr>"
        + "".join(rows) + "</table>"
        "<p style='color:#888'>提醒：「面議」請自行確認是否達 5 萬；公司是否家族企業、"
        "主管風格請另外查證。</p>"
    )


def send_mail(html, count):
    user = os.environ["GMAIL_USER"]
    pwd = os.environ["GMAIL_APP_PASSWORD"]
    to = os.environ.get("MAIL_TO", user)
    msg = MIMEText(html, "html", "utf-8")
    msg["Subject"] = f"104 大型科技業新職缺 {count} 筆 ({datetime.now():%m/%d})"
    msg["From"] = user
    msg["To"] = to
    with smtplib.SMTP_SSL("smtp.gmail.com", 465, context=ssl.create_default_context()) as s:
        s.login(user, pwd)
        s.send_message(msg)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true", help="只顯示，不寄信、不記錄已讀")
    args = ap.parse_args()

    jobs = collect()
    seen = load_seen()
    new_jobs = [j for j in jobs if j["id"] not in seen]
    print(f"符合條件 {len(jobs)} 筆，其中新職缺 {len(new_jobs)} 筆")

    if args.dry_run:
        for j in sorted(new_jobs, key=sort_key):
            print(f"- {j['company']} | {j['title']} | {j['addr'][:12]} | "
                  f"{j['salary_desc'] or '面議'} | {j['link']}")
        return

    if not new_jobs:
        print("今天沒有新職缺，不寄信。")
        return

    send_mail(build_html(new_jobs), len(new_jobs))
    seen.update(j["id"] for j in new_jobs)
    save_seen(seen)
    print("已寄出。")


if __name__ == "__main__":
    main()

